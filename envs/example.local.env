# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=
COOKIE_DOMAIN=

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=localhost
DB_PORT=3306
DB_EXPOSE_PORT=3306
DB_USER=ozcoding
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=ai_health

# valkey (예측 큐)
VALKEY_URL=redis://localhost:6379/0
PREDICTION_QUEUE_KEY=pred:queue

# ai-worker 모델
MODEL_DIR=data/experiment-refit

# 로컬 PHOTO 인증 비공개 저장소
EVIDENCE_STORAGE_DIR=./media/evidence

# 질의 챗봇. 키가 없거나 꺼져 있으면 규칙 추천만 돌려준다
# 확인: uv run python -m scripts.rag.check_openai [--base-url http://localhost:8000]
CHALLENGE_CHAT_ENABLED=false
# 키는 이 예시 파일이 아니라 복사한 .env(로컬) · envs/.prod.env(배포)에만 넣는다. 둘 다 gitignore 대상이다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
